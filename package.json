{
  "name": "claude-harness",
  "displayName": "Claude Harness",
  "description": "Visualize and edit your Claude Code harness in VS Code: memory, rules, agents, skills, commands, output styles, workflows, hooks, MCP servers and plugins, globally and per repository.",
  "version": "0.5.0",
  "publisher": "integrations-at",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1F1E1D",
    "theme": "dark"
  },
  "author": {
    "name": "Alexander Kastil",
    "email": "alexander.kastil@integrations.at",
    "url": "https://integrations.at/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexander-kastil/claude-harness"
  },
  "homepage": "https://github.com/alexander-kastil/claude-harness#readme",
  "bugs": {
    "url": "https://github.com/alexander-kastil/claude-harness/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "harness",
    "agents",
    "skills",
    "anthropic",
    "mcp",
    "hooks",
    "CLAUDE.md"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Claude Harness",
      "properties": {
        "claudeHarness.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder of the global harness. Empty means `~/.claude`.",
          "order": 1
        },
        "claudeHarness.repoFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders added with **Add Repo...**. Each is a repo folder, or a parent folder whose subfolders are repos. A folder is listed when it has a `.claude` folder or a `CLAUDE.md`.",
          "order": 2
        },
        "claudeHarness.removedRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Repo folders hidden with **Remove Repo...**. Adding the repo or its parent folder again shows it again.",
          "order": 3
        },
        "claudeHarness.plan": {
          "type": "string",
          "enum": [
            "",
            "pro",
            "max5",
            "max20",
            "team-standard",
            "team",
            "api"
          ],
          "enumItemLabels": [
            "Not set",
            "Pro",
            "Max 5x",
            "Max 20x",
            "Team Standard",
            "Team Premium",
            "API billing"
          ],
          "default": "",
          "markdownDescription": "The plan of the Claude account in the global harness folder. Session cost is then shown against that plan's weekly limit estimate. Empty means no plan.",
          "order": 4
        },
        "claudeHarness.weekStart": {
          "type": "string",
          "default": "",
          "markdownDescription": "When the weekly limit of the main account resets, as weekday and UTC hour, for example `Mon 11:00`. The weekly summary counts from the last reset. Empty means a rolling 7 days.",
          "order": 5
        },
        "claudeHarness.accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Name shown on the sessions of this account. Defaults to the folder name."
              },
              "path": {
                "type": "string",
                "description": "The Claude config folder of the account, the one Claude Code reads from `CLAUDE_CONFIG_DIR`. A leading `~` is the home folder."
              },
              "plan": {
                "type": "string",
                "enum": [
                  "",
                  "pro",
                  "max5",
                  "max20",
                  "team-standard",
                  "team",
                  "api"
                ],
                "enumItemLabels": [
                  "Not set",
                  "Pro",
                  "Max 5x",
                  "Max 20x",
                  "Team Standard",
                  "Team Premium",
                  "API billing"
                ],
                "description": "The plan of this account."
              },
              "weekStart": {
                "type": "string",
                "description": "When the weekly limit of this account resets, as weekday and UTC hour, for example `Mon 11:00`. Empty means a rolling 7 days."
              }
            },
            "required": [
              "path"
            ]
          },
          "default": [],
          "markdownDescription": "More Claude accounts on this machine, each with its own config folder, for example `~/.claude-work`. Sessions of every account are listed, labeled with the account. The global harness folder stays the main account, labeled Default.",
          "order": 6
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeHarness",
          "title": "Claude Harness",
          "icon": "media/harness.svg"
